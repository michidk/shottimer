{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "semanticCommits": "enabled",
  "extends": [
    "github>michidk/workflows//templates/presets/renovate"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "All Cargo Dependencies"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchDepNames": [
        "embedded-hal-02"
      ],
      "allowedVersions": "<1.0.0"
    },
    {
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.14\\./"
    }
  ]
}
